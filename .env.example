# SewornaAI - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Server Environment Variables (apps/server)
# ============================================

# MongoDB connection (required)
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
# Or for local/explicit connection:
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_HOST=localhost:27017
MONGODB_DB_NAME=sewornaai

# Firebase Admin SDK (required)
# Either provide the service account JSON as a string:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Or set GOOGLE_APPLICATION_CREDENTIALS to point to a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Server port (optional, default: 4000)
PORT=4000

# CORS - allowed client origin (required)
CLIENT_ORIGIN=http://localhost:5173

# Paystack payment integration (required for subscription features)
PAYSTACK_SECRET_KEY=sk_live_...

# SMTP configuration for contact form (optional but recommended)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=your-smtp-password
CONTACT_FROM_EMAIL=mailer@example.com
CONTACT_TO_EMAIL=admin@example.com

# Search rate limiting (optional, default: 30 requests per minute)
SEARCH_REQUESTS_PER_MINUTE=30

# Search provider timeout (optional, default: 8000ms)
SEARCH_PROVIDER_TIMEOUT_MS=8000


# ============================================
# Client Environment Variables (apps/client)
# ============================================

# API base URL (optional, defaults to http://localhost:4000 in dev, auto-detected in production)
# VITE_API_BASE_URL=http://localhost:4000

# Firebase configuration (required for authentication)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
